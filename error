import pandas as pd

files = {
    "STOCK SILVER": "stock silver.parquet",
    "NEWS SILVER": "silver news.parquet",
    "NEWS BY TICKER": "silve news by ticker.parquet"
}

for name, path in files.items():
    print("\n" + "=" * 60)
    print(name)
    print("=" * 60)

    df = pd.read_parquet(path)

    print("\nCOLUMNS:")
    print(df.columns.tolist())

    print("\nDATA TYPES:")
    print(df.dtypes)

    print("\nSAMPLE RECORDS:")
    print(df.head(3).to_string())
